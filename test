import java.io.IOException;

public class SpawnCmd {
    public static void main(String[] args) {
        try {
            // Launch a new visible Windows command prompt
            new ProcessBuilder("cmd.exe", "/c", "start", "cmd.exe").inheritIO().start();
        } catch (IOException e) {
            System.err.println("Failed to launch cmd: " + e.getMessage());
            e.printStackTrace();
        }
    }
}
